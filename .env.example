# AtelierPilot AI – Vorlage. Kopieren nach .env und ausfüllen. NIE echte Werte hier eintragen.
SHOPIFY_API_KEY=""
SHOPIFY_API_SECRET=""
SHOPIFY_APP_URL="https://IHRE-DOMAIN"
SCOPES="read_products,write_products,read_orders,write_orders,read_inventory,write_inventory,read_content,write_content,read_files,write_files"
OWNER_SHOP_DOMAIN="wertarbeitmanufaktur.myshopify.com"
DRY_RUN_MODE="true"
BILLING_LIVE="false"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/atelierpilot?schema=public"
PORT="3000"

# Geheimnisse (mind. 16 Zeichen, am besten 32 – erzeugt: node scripts/ensure-env.mjs)
CRON_SECRET=""
SELFTEST_TOKEN=""
MOBILE_MONITOR_TOKEN=""
UNSUBSCRIBE_SECRET=""
# AES-256-GCM-Schluessel fuer Bankdaten in ShopSettings (64 Hex-Zeichen, geheim und dauerhaft sichern)
BRAND_SETTINGS_ENCRYPTION_KEY=""
# Separater dauerhafter 32-Byte-Hex-Schluessel fuer den Inhaber-Tresor
AETHERION_VAULT_KEY=""

# KI (optional – ohne Schlüssel läuft die Haus-KI)
GEMINI_API_KEYS=""
GROQ_API_KEY=""
OPENROUTER_API_KEY=""
MISTRAL_API_KEY=""
AI_CLOUD_ENABLED="false"
GEMINI_MODEL_CANDIDATES=""
MISTRAL_MODEL=""
GROQ_MODEL=""
OPENROUTER_MODEL=""

# Neon-Speicherwächter: nur mit dem tatsächlich konfigurierten Projektlimit ausfüllen
DATABASE_STORAGE_LIMIT_BYTES=""

# E-Mail-Versand (optional). Gmail: App-Passwort verwenden, nie das Kontopasswort.
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
# oder beliebiger SMTP:
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM=""
# Posteingang (optional)
IMAP_HOST=""
IMAP_USER=""
IMAP_PASS=""

STOREFRONT_URL=""

# Plattform-Konnektoren (nur HTTPS-Zieladressen, keine Secrets ins Git)
GOOGLE_SHEETS_WEBHOOK_URL=""
GOOGLE_SHEETS_WEBHOOK_SECRET=""
WHATSAPP_CLOUD_TOKEN=""
WHATSAPP_PHONE_ID=""
